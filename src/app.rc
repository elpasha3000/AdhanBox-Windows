#include <windows.h>

1 ICON "..\\assets\\adhanbox.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,3,0,0
 PRODUCTVERSION 0,3,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "MagicWeb"
            VALUE "FileDescription",  "AdhanBox - prayer times and adhan for Windows"
            VALUE "FileVersion",      "0.3.0.0"
            VALUE "InternalName",     "AdhanBox"
            VALUE "LegalCopyright",   "Free software (MIT License) - magicweb.win"
            VALUE "OriginalFilename", "AdhanBox.exe"
            VALUE "ProductName",      "AdhanBox"
            VALUE "ProductVersion",   "0.3.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
